{
  "doubao": {
    "voice": "zh_female_roumeinvyou_uranus_bigtts",
    "speech_rate": 20,
    "resource_id": "seed-tts-2.0",
    "endpoint": "https://openspeech.bytedance.com/api/v3/tts/unidirectional"
  },
  "glm": {
    "enabled": true,
    "model": "glm-4-flash",
    "summary_threshold": 80,
    "max_chars": 500,
    "fallback_chars": 120,
    "timeout": 5,
    "endpoint": "https://open.bigmodel.cn/api/paas/v4/chat/completions"
  },
  "events": {
    "stop":            { "enabled": true,  "mode": "fixed-phrase", "phrase": "已完成" },
    "notification":    { "enabled": true,  "phrase": "等待授权" },
    "stop-failure":    { "enabled": false, "phrase": "执行失败" },
    "session-start":   { "enabled": false, "phrase": "开始工作" },
    "session-end":     { "enabled": false, "phrase": "会话结束" },
    "subagent-stop":   { "enabled": false, "phrase": "子任务完成" },
    "task-completed":  { "enabled": false, "phrase": "任务完成" },
    "pre-compact":     { "enabled": false, "phrase": "即将压缩上下文" },
    "worktree-create": { "enabled": false, "phrase": "工作树已创建" }
  }
}
