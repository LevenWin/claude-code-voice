{
  "doubao": {
    "voice": "zh_male_guangxiyuanzhou_moon_bigtts",
    "speech_rate": 30,
    "resource_id": "volc.service_type.10029",
    "endpoint": "https://openspeech.bytedance.com/api/v3/tts/unidirectional"
  },
  "glm": {
    "enabled": true,
    "model": "glm-4-flash",
    "summary_threshold": 80,
    "max_chars": 500,
    "fallback_chars": 120,
    "timeout": 5,
    "endpoint": "https://open.bigmodel.cn/api/paas/v4/chat/completions"
  },
  "events": {
    "stop":            { "enabled": true,  "mode": "fixed-phrase", "phrase": "搞定" },
    "notification":    { "enabled": true,  "phrase": "哎，授权下" },
    "stop-failure":    { "enabled": false, "phrase": "执行失败" },
    "session-start":   { "enabled": false, "phrase": "牛马开始上班吧" },
    "session-end":     { "enabled": false, "phrase": "下班咯" },
    "subagent-stop":   { "enabled": false, "phrase": "子任务完成啦" },
    "task-completed":  { "enabled": false, "phrase": "搞完啦" },
    "pre-compact":     { "enabled": false, "phrase": "我要压缩上下文啦" },
    "worktree-create": { "enabled": false, "phrase": "工作树已创建" }
  }
}
